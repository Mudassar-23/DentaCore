# ============================
# DentaCore Environment Configuration
# ============================
# COPY this file to .env and fill in your real values.
# .env is gitignored — NEVER commit actual secrets.

# ---- Database ----
# Switch provider to PostgreSQL or SQLite (auto-detects PostgreSQL with auto-fallback to SQLite)
DATABASE_URL=postgresql://username:password@localhost:5432/aidocs
SQLITE_CONNECTION=Data Source=data/aiNEWkkk.db

# Alternative explicit ADO.NET format:
# DATABASE_PROVIDER=PostgreSQL
# POSTGRES_CONNECTION=Host=localhost;Port=5432;Database=dentacore_db;Username=dentacore_user;Password=YourStrongPassword123!;

# ---- JWT Settings ----
JWT_SECRET=YourSuperSecretKeyThatIsAtLeast32CharactersLong!!
JWT_ISSUER=DentaCore
JWT_AUDIENCE=DentaCoreApp
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ---- Default Admin Account (seeded on first run) ----
ADMIN_FULLNAME=System Administrator
ADMIN_EMAIL=admin@dentacore.local
ADMIN_PASSWORD=Admin@12345!
ADMIN_PHONE=+1234567890

# ---- Default Doctor Account (seeded on first run) ----
DOCTOR_FULLNAME=Dr. Demo Doctor
DOCTOR_EMAIL=doctor@dentacore.local
DOCTOR_PASSWORD=Doctor@12345!
DOCTOR_PHONE=+0987654321
DOCTOR_SPECIALIZATION=General Dentistry
DOCTOR_LICENSE=DDS-00001
DOCTOR_FEE=150.00

# ---- Default Patient Account (seeded on first run) ----
PATIENT_FULLNAME=Jane Doe
PATIENT_EMAIL=patient@dentacore.local
PATIENT_PASSWORD=Patient@12345!
PATIENT_PHONE=+15552345678

# ---- Application ----
APP_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Serilog ----
LOG_LEVEL=Information
