# =============================================================================
# DentaCore .gitignore
# Enterprise-grade Git ignore configuration for .NET 9 + Web Frontends
# =============================================================================

# -----------------------------------------------------------------------------
# 1. .NET / C# Build & Compilation Outputs
# -----------------------------------------------------------------------------
**/[Bb]in/
**/[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]uild/
Generated\ Files/

# Visual Studio user-specific files
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.rsuser

# NuGet packages & tools
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nupkg
**/nuget.exe

# -----------------------------------------------------------------------------
# 2. Testing, Code Coverage & Diagnostics
# -----------------------------------------------------------------------------
[Tt]est[Rr]esults/
**/[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
*.dmp
*.mdmp
*.crashdump

# -----------------------------------------------------------------------------
# 3. IDEs, Editors & Tooling
# -----------------------------------------------------------------------------
# Visual Studio
.vs/
*.opendb

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider
.idea/
*.sln.iml
*.DotSettings.user

# Editor temp / swap files
*.swp
*.swo
*~
*.bak
*.tmp
*.temp

# -----------------------------------------------------------------------------
# 4. Environment & Secrets (Security Critical)
# -----------------------------------------------------------------------------
# Never commit environment variables or live secrets
.env
.env.*
!.env.example

# ASP.NET configuration overrides & local secret files
appsettings.Production.json
appsettings.*.local.json
appsettings.Local.json
appsettings.secrets.json
secrets.json
local.settings.json

# -----------------------------------------------------------------------------
# 5. Database & Local Storage Files
# -----------------------------------------------------------------------------
# SQLite local databases and write-ahead logs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
dentacore.db*

# -----------------------------------------------------------------------------
# 6. Runtime Generated Files & Artifacts
# -----------------------------------------------------------------------------
# Dynamic PDF receipts generated by QuestPDF
[Rr]eceipts/
**/[Rr]eceipts/
*.pdf

# Application and HTTP logs
[Ll]ogs/
**/[Ll]ogs/
*.log

# Temporary runtime storage
temp/
tmp/

# -----------------------------------------------------------------------------
# 7. Frontend, Node & Web Assets
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# 8. Operating System Specific Files
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
.fuse_hidden*
.directory
